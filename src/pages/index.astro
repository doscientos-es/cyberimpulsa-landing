---
import MainLayout from "~/layouts/MainLayout.astro";

import ClientsShowcase from "~/components/sections/ClientsShowcase.astro";
import Hero from "~/components/sections/Hero.astro";
import Hype from "~/components/sections/Hype.astro";
import Impact from "~/components/sections/Impact.astro";
import Method from "~/components/sections/Method.astro";

const title = "Cyberimpulsa | Agencia de Marketing B2B para Software e IA";
const description =
    "Cyberimpulsa es una agencia de marketing especializada en captación de clientes B2B para empresas de desarrollo de software y agencias de IA. Resultados en los primeros 2 meses.";
---

<MainLayout title={title} description={description}>
    <Hero />
    <Impact />
    <ClientsShowcase />
    <Method />
    <Hype />
</MainLayout>
